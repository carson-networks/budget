{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["buf.gen.yaml"],
      "matchStrings": [
        "git_repo:\\s+https://github\\.com/carson-networks/budget-server\\.git\\n\\s+tag:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "budget-server-proto",
      "packageNameTemplate": "carson-networks/budget-server",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Group JavaScript/TypeScript (npm) dependency updates",
      "matchManagers": ["npm"],
      "groupName": "JavaScript dependencies",
      "groupSlug": "javascript"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "budget-server proto release tags (keep separate; regenerate stubs)",
      "matchDepNames": ["budget-server-proto"],
      "labels": ["proto"],
      "groupName": "budget-server proto",
      "groupSlug": "budget-server-proto",
      "postUpgradeTasks": {
        "commands": ["pnpm install --frozen-lockfile", "pnpm run generate"],
        "executionMode": "branch"
      }
    }
  ]
}
